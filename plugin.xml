<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-media-controls"
        version="2.5.2">

    <name>MediaControls</name>
    <description>Lock-screen and notification "Now Playing" media controls for Android. (iOS uses the Web MediaSession API directly - see README.)</description>
    <license>MIT</license>

    <js-module src="www/MediaControls.js" name="MediaControls">
        <clobbers target="cordova.plugins.MediaControls" />
    </js-module>

    <!-- ===================== ANDROID ===================== -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="MediaControls">
                <param name="android-package" value="com.outsystems.plugins.mediacontrols.MediaControlsPlugin" />
            </feature>
        </config-file>

        <!--
            FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK: required to
            run MediaPlaybackService as a real foreground service (the piece
            that exempts the app's WebView from background JS-timer throttling
            and Doze network deferral - a plain notification alone does not
            grant this). MEDIA_PLAYBACK type + its permission are mandatory on
            Android 14 (API 34)+ for services declaring foregroundServiceType
            "mediaPlayback".
            WAKE_LOCK: required for the PARTIAL_WAKE_LOCK the service holds
            for the duration of playback, so the CPU doesn't fully suspend
            mid-track with the screen off.
        -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <!--
                No MediaButtonReceiver is declared on purpose. androidx's
                MediaButtonReceiver forwards to a Service that handles
                MEDIA_BUTTON (or a MediaBrowserService); this plugin has
                neither, so an exported receiver here could only crash when a
                media-button broadcast reached it (flagged by Appknox as
                "Unprotected Exported Receivers"). While a session is active
                the system routes hardware media buttons straight to the
                MediaSession, and notification button taps use a private,
                non-exported receiver registered at runtime in
                MediaControlsPlugin.
            -->
            <service android:name="com.outsystems.plugins.mediacontrols.MediaPlaybackService"
                     android:exported="false"
                     android:foregroundServiceType="mediaPlayback" />
        </config-file>

        <source-file src="src/android/MediaControlsPlugin.java"
                     target-dir="src/com/outsystems/plugins/mediacontrols" />

        <source-file src="src/android/MediaPlaybackService.java"
                     target-dir="src/com/outsystems/plugins/mediacontrols" />

        <resource-file src="src/android/ic_media_notification.xml"
                        target="res/drawable/ic_media_notification.xml" />

        <framework src="androidx.media:media:1.6.0" />
        <framework src="androidx.core:core:1.10.1" />
    </platform>

</plugin>
